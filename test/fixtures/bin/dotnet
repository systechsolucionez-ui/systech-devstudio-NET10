#!/usr/bin/env bash
# dotnet SIMULADO para los tests: imita la salida real de build, test y list package.
case "$1" in
  --list-sdks) echo "10.0.100 [/usr/share/dotnet/sdk]";;
  build)
    if [ -f FAIL_BUILD ]; then
      echo "/w/src/Api/Program.cs(12,5): error CS1002: ; expected [/w/src/Api/Api.csproj]"
      echo "Build FAILED."; echo "    0 Warning(s)"; echo "    1 Error(s)"; exit 1
    fi
    echo "/w/src/Api/Program.cs(3,1): warning CS8618: Non-nullable property [/w/src/Api/Api.csproj]"
    echo "Build succeeded."; echo "    1 Warning(s)"; echo "    0 Error(s)";;
  test)
    if [ -f FAIL_TEST ]; then
      echo "  Failed PaymentSagaTests.Retry_DoesNotChargeTwice [12 ms]"
      echo "Failed!  - Failed:     1, Passed:    41, Skipped:     0, Total:    42, Duration: 2 s - App.Tests.dll (net10.0)"
      echo "Passed!  - Failed:     0, Passed:     1, Skipped:     0, Total:     1, Duration: 1 s - Domain.Tests.dll (net10.0)"
      exit 1
    fi
    echo "Passed!  - Failed:     0, Passed:    42, Skipped:     0, Total:    42, Duration: 2 s - App.Tests.dll (net10.0)"
    echo "Passed!  - Failed:     0, Passed:     1, Skipped:     0, Total:     1, Duration: 1 s - Domain.Tests.dll (net10.0)";;
  list)
    echo "The following sources were used:"
    echo "Project \`Api\` has the following vulnerable packages"
    echo "   [net10.0]: "
    echo "   Top-level Package      Requested   Resolved   Severity   Advisory URL"
    if [ -f VULN_HIGH ]; then echo "   > Newtonsoft.Json      12.0.1      12.0.1     High       https://github.com/advisories/GHSA-5crp-9r3c-p9vr"; fi
    echo "   > OpenTelemetry.Api    1.10.0      1.10.0     Moderate   https://github.com/advisories/GHSA-8785-wc3w-h8q6";;
esac
